{
  "appId": "com.netpulse.nms",
  "appName": "NetPulse",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#0c111d",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0c111d",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "native"
    }
  }
}
